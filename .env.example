APP_NAME="Blindem Liquidaciones"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=blindem
DB_USERNAME=postgres
DB_PASSWORD=postgres
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
TRUSTED_PROXIES=

# Asistente de IA: simulated (sin red) u ollama. Ver docs/IA.md.
AI_DRIVER=simulated
# Local: http://localhost:11434 (Docker usa http://host.docker.internal:11434). Cloud: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
# Solo para Ollama Cloud: crea la clave en https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_TOKENS=1200
# Modelos con razonamiento (qwen3.5, gpt-oss): false responde mucho más rápido.
OLLAMA_THINK=false
# Búsqueda semántica en la base de conocimiento (RAG). Vacío: solo búsqueda por palabras (BM25).
OLLAMA_EMBED_MODEL=

# Correo (recuperar contraseña). log: los correos quedan en storage/logs/laravel.log. Producción: smtp.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-responder@blindem.test"
MAIL_FROM_NAME="${APP_NAME}"
